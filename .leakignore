# .leakignore — allowed private-path references in this public repo.
#
# Format: <path-glob> <tag[,tag...]>   # reason
#
# The leak scanner (scripts/check-no-private-leaks.sh) ignores matches where
# BOTH the file path matches the glob AND the leak tag is listed. Unknown
# leaks still fail CI.

# By-design opt-in: revkit's WSL devkit installs a personal-config
# bashrc fragment that sources the internal revcon profiles if present.
# File is explicitly named "70-revcon-personal.sh" — opt-in, runtime-no-op
# when the private dir isn't present.
shell/shellrc.d/70-revcon-personal.sh   private-jv-repo

# By-design: the WSL devkit bootstrap discovers .revealui under the LTS
# drive mounts (E: → /mnt/e or D: → /mnt/d). Per ~/.claude/rules/wsl.md
# this is the documented portable-devkit discovery path.
shell/shellrc.d/00-base.sh              lts-drive   # devkit auto-discovery
shell/setup-wsl-boot.sh                lts-drive   # documented operator-run-this examples

# By-design: the Windows-host DR backup tooling targets the LTS drive's
# Windows path. These are committed operational scripts whose default
# SnapshotDir param IS the backup target, plus the architecture docs that
# describe it. The lts-drive-win pattern is meant to catch stray refs in
# other files, not these canonical ones.
scripts/weekly-wsl-backup.ps1           lts-drive-win
scripts/check-backup-staleness.ps1      lts-drive-win
docs/MASTER_SPEC.md                     lts-drive-win   # documents the DR backup architecture
docs/MASTER_PLAN.md                     lts-drive-win   # documents the weekly backup job

# By-design: the GAP-116 anti-regression CI job must name the bare account
# token + the /mnt/c/Users literal in its grep patterns + error strings to
# scan for them. This is the workflow that enforces the rule, not a leak of it.
.github/workflows/ci.yml                bare-username,abs-wsl-windows-user


# By-design: the issue/PR-body leak-scan gitleaks config (consumed by
# .github/workflows/issue-leak-scan.yml) must name the private-path and
# username literals in its detection regexes + keywords to catch them in
# issue bodies. This is the config that enforces the rule, not a leak of
# it (mirrors the ci.yml anti-regression entries).
.gitleaks.issues.toml                   lit-username,abs-home-path,private-jv-repo,private-jv-name,bare-username

# Materialized planning hardline may mention private TRACKER; not a path leak.
.claude/rules/planning.md               internal-coord-hub

# By-design: the code owners file must name the GitHub review accounts.
.github/CODEOWNERS                      lit-username
