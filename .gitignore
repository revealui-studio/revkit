# Logs
scripts/logs/
*.log

# OS
.DS_Store
Thumbs.db

# Secrets
secrets/
*.pem
*.key
id_ed25519*
!*.pub

# Operator-local client-name watchlist (Layer B) and the local fallback
# for scripts/check-client-leaks.sh (tag|literal|reason). Never commit.
.client-name-watchlist.local

# Passage store (its own git repo)
passage-store/

# PowerShell artifacts
*.pssproj
*.pssproj.user

# Docker runtime env
shell/docker/.env

# Editor
*.swp
*.swo
*~
.idea/
.vscode/

# Claude Code per-developer state (settings.local.json, session caches,
# worktrees). Materialized rules/agents/skills are tracked (GAP-372 copy-mode);
# keep local state ignored so it cannot bypass the Private Leak Scan gate.
.claude/*
!.claude/rules/
!.claude/agents/
!.claude/skills/
!.claude/.revcon-manifest.json

# Backups / binary archives — never track snapshots. check-no-private-leaks.sh
# excludes *.tar.gz and gitleaks does not unpack archives, so a tracked archive
# silently bypasses every leak gate. Keep snapshots in the offline LTS archive.
backups/
*.tar.gz
*.tgz
*.tar
*.zip
