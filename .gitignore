# Logs
scripts/logs/
*.log

# OS
.DS_Store
Thumbs.db

# Secrets
secrets/
*.pem
*.key
id_ed25519*
!*.pub

# Operator-local client-name watchlist (Layer B). Never commit real terms.
.client-name-watchlist.local

# Passage store (its own git repo)
passage-store/

# PowerShell artifacts
*.pssproj
*.pssproj.user

# Docker runtime env
shell/docker/.env

# Editor
*.swp
*.swo
*~
.idea/
.vscode/

# Vendor caches and projections are local. Maintained policy and its
# ownership manifest live under .revealui/content and .revealui/.
.claude/
.test-deps/
__pycache__/

# Backups / binary archives — never track snapshots. check-no-private-leaks.sh
# excludes *.tar.gz and gitleaks does not unpack archives, so a tracked archive
# silently bypasses every leak gate. Keep snapshots in the offline LTS archive.
backups/
*.tar.gz
*.tgz
*.tar
*.zip
